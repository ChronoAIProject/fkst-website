<!doctype html>
<html lang="{{ lang }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <meta
      name="description"
      content="{{ description }}"
    >
    <link rel="stylesheet" href="{{ "/assets/css/style.css" | url }}">
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="{{ brandHref | url }}" aria-label="fkst home">fkst</a>
      <nav class="top-nav" aria-label="Primary">
        {% for item in nav %}
          {% if item.current %}
            <span aria-current="page">{{ item.label }}</span>
          {% else %}
            {% if item.href | shouldUseEleventyUrl %}
              <a href="{{ item.href | url }}">{{ item.label }}</a>
            {% else %}
              <a href="{{ item.href }}"{{ item.href | externalLinkAttributes | safe }}>{{ item.label }}{{ item.href | externalLinkMarker | safe }}</a>
            {% endif %}
          {% endif %}
        {% endfor %}
      </nav>
      <div class="header-actions">
        {% if localeAlternates %}
          <nav class="language-switch" aria-label="Language" data-locale-switcher>
            {% for locale in locales.supportedLocales %}
              {% set alternateHref = localeAlternates[locale.code] %}
              {% if locale.code == localeCode %}
                <span
                  aria-current="page"
                  data-locale-option="{{ locale.code }}"
                >{{ locale.label }}</span>
              {% elif alternateHref %}
                {% if alternateHref | shouldUseEleventyUrl %}
                  <a
                    href="{{ alternateHref | url }}"
                    hreflang="{{ locale.code }}"
                    lang="{{ locale.htmlLang }}"
                    data-locale-option="{{ locale.code }}"
                  >{{ locale.label }}</a>
                {% else %}
                  <a
                    href="{{ alternateHref }}"
                    hreflang="{{ locale.code }}"
                    lang="{{ locale.htmlLang }}"
                    data-locale-option="{{ locale.code }}"
                    {{- alternateHref | externalLinkAttributes | safe }}
                  >{{ locale.label }}{{ alternateHref | externalLinkMarker | safe }}</a>
                {% endif %}
              {% endif %}
            {% endfor %}
          </nav>
        {% endif %}
        {% include "components/PrintPageButton.njk" %}
      </div>
    </header>

    <main>
      {% block content %}{% endblock %}
    </main>

    <footer class="site-footer">
      {% set lastUpdatedData = lastUpdated | lastUpdatedMetadata %}
      {% if lastUpdatedData %}
        <p class="footer-last-updated">Last updated: <time datetime="{{ lastUpdatedData.datetime }}" data-last-updated>{{ lastUpdatedData.label }}</time></p>
      {% endif %}
      {% if footerHref and footerLabel %}
        {% if footerHref | shouldUseEleventyUrl %}
          <p><a href="{{ footerHref | url }}">{{ footerLabel }}</a></p>
        {% else %}
          <p><a href="{{ footerHref }}"{{ footerHref | externalLinkAttributes | safe }}>{{ footerLabel }}{{ footerHref | externalLinkMarker | safe }}</a></p>
        {% endif %}
      {% else %}
        <p>{{ footerText }}</p>
      {% endif %}
    </footer>

    {% include "components/BackToTopButton.njk" %}
    {% include "components/KeyboardShortcutHelpOverlay.njk" %}
    <script src="{{ "/assets/js/code-block-copy.js" | url }}" defer data-code-block-copy-script></script>
    <script src="{{ "/assets/js/keyboard-shortcuts.js" | url }}" defer data-keyboard-shortcut-script></script>
  </body>
</html>
