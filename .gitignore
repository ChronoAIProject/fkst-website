# Local, machine-specific config. Tracked template lives in env.example.
.env
__pycache__/

# .fkst/ is the runtime interface dir, mixed tracked + ignored. This host repo
# is website-source-primary, so its OWN Lua packages are committed under
# .fkst/local-packages/ (and custom std under .fkst/std/) — those are TRACKED.
# Only the runtime parts are ignored:
/.fkst/packages
/.fkst/run/
/.fkst/env
