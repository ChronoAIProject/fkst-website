{% set printLabel = "打印页面" if lang == "zh-Hans" else "Print" %}
{% set printAriaLabel = "打印此页面" if lang == "zh-Hans" else "Print this page" %}
<div class="print-page-control" data-print-page-control>
  <button
    class="print-page-button"
    type="button"
    data-print-page-button
    aria-label="{{ printAriaLabel }}"
    disabled
  >
    <span>{{ printLabel }}</span>
  </button>
</div>
<script data-print-page-script>
  (() => {
    const button = document.querySelector("[data-print-page-button]");
    if (!(button instanceof HTMLButtonElement) || typeof window.print !== "function") {
      return;
    }

    const root = document.documentElement;
    const setPrintState = () => {
      root.setAttribute("data-printing", "true");
    };
    const clearPrintState = () => {
      root.removeAttribute("data-printing");
    };
    const openPrintView = () => {
      setPrintState();
      const invokePrint = () => {
        try {
          window.print();
        } finally {
          window.setTimeout(clearPrintState, 1000);
        }
      };

      if (typeof window.requestAnimationFrame === "function") {
        window.requestAnimationFrame(() => {
          window.requestAnimationFrame(invokePrint);
        });
        return;
      }

      window.setTimeout(invokePrint, 0);
    };
    const api = window.fkstPrintPage && typeof window.fkstPrintPage === "object"
      ? window.fkstPrintPage
      : {};

    api.openPrintView = openPrintView;
    window.fkstPrintPage = api;
    button.disabled = false;
    button.addEventListener("click", () => {
      window.fkstPrintPage.openPrintView();
    });
    window.addEventListener("beforeprint", setPrintState);
    window.addEventListener("afterprint", clearPrintState);

    if (typeof window.matchMedia === "function") {
      const media = window.matchMedia("print");
      const syncPrintMedia = (event) => {
        if (event.matches) {
          setPrintState();
        } else {
          clearPrintState();
        }
      };

      if (typeof media.addEventListener === "function") {
        media.addEventListener("change", syncPrintMedia);
      } else if (typeof media.addListener === "function") {
        media.addListener(syncPrintMedia);
      }
    }
  })();
</script>
