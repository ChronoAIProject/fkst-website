{% extends "layouts/base.njk" %}
{% set docsTocEntries = page | docsTocEntries %}
{% set hasDocsTocEntries = (docsTocEntries | length) > 1 %}
{% if post %}
  {% set postTitle = post.articleTitle %}
  {% set postIntro = post.articleIntro %}
  {% set postEyebrow = post.articleEyebrow %}
{% else %}
  {% set postTitle = articleTitle or title %}
  {% set postIntro = articleIntro %}
  {% set postEyebrow = articleEyebrow %}
{% endif %}

{% block content %}
{% include "components/ArticleScrollProgress.njk" %}
{% include "components/ArticleHeader.njk" %}
{% include "components/ArticleShell.njk" %}
{% endblock %}

{% block scripts %}
    {{ super() }}
    {% include "components/ArticleScripts.njk" %}
{% endblock %}
