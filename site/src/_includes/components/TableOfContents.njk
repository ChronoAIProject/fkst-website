{% set items = tableOfContents or [] %}
{% if items | length %}
  <aside class="toc-sidebar">
    <nav
      class="toc-nav"
      data-toc-nav
      aria-label="{% if lang == 'zh-Hans' %}目录{% else %}Table of contents{% endif %}"
    >
      <p class="toc-title">{% if lang == 'zh-Hans' %}目录{% else %}Table of contents{% endif %}</p>
      <ol class="toc-list">
        {% for item in items %}
          <li class="toc-item toc-item-level-{{ item.level }}">
            <a data-toc-link href="#{{ item.id | escape }}">{{ item.text | escape }}</a>
            {% if item.children | length %}
              <ol class="toc-list toc-list-nested">
                {% for child in item.children %}
                  <li class="toc-item toc-item-level-{{ child.level }}">
                    <a data-toc-link href="#{{ child.id | escape }}">{{ child.text | escape }}</a>
                  </li>
                {% endfor %}
              </ol>
            {% endif %}
          </li>
        {% endfor %}
      </ol>
    </nav>
  </aside>
{% endif %}
