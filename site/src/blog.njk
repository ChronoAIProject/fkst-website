---
layout: layouts/page.njk
permalink: /blog.html
lang: en
localeCode: en
title: Blog | fkst
description: "Project updates, releases, and technical notes from the fkst autonomous pipeline."
brandHref: /
nav:
  - label: Home
    href: /
  - label: Blog
    current: true
  - label: Architecture
    href: /architecture.html
  - label: Doctrine
    href: /doctrine.html
  - label: fkst-substrate
    href: https://github.com/ChronoAIProject/fkst-substrate
  - label: fkst-packages
    href: https://github.com/ChronoAIProject/fkst-packages
  - label: fkst-website
    href: https://github.com/ChronoAIProject/fkst-website
localeAlternates:
  en: /blog.html
  zh: /zh/blog.html
footerHref: /
footerLabel: Back to home
---
{% from "components/BlogCategoryBadge.njk" import blogCategoryBadge %}

<section class="page-header" aria-labelledby="page-title">
  <p class="eyebrow">Blog</p>
  <h1 id="page-title">Updates from the fkst pipeline.</h1>
  <p class="page-intro">
    Release notes, project news, and technical write-ups from the autonomous
    development loop that maintains this site.
  </p>
</section>

<section class="features blog-index" aria-labelledby="blog-index-title">
  <div class="section-heading">
    <h2 id="blog-index-title" class="heading-anchor-target">Latest posts{% headingAnchor "blog-index-title", "Latest posts", "Link to Latest posts section" %}</h2>
  </div>
  <div class="feature-grid">
    {% for item in blogPosts.en %}
    {% set post = item.post %}
    <article
      class="feature-card blog-post-summary"
      data-post-contract="{{ post.contract }}"
      data-post-source-format="{{ post.sourceFormat }}"
    >
      <div class="blog-post-summary-meta">
        {{ blogCategoryBadge(post.category) }}
        <time datetime="{{ post.publishedDate }}">{{ item.displayDate }}</time>
      </div>
      <h3>{{ post.articleTitle }}</h3>
      <p>{{ post.summary }}</p>
    </article>
    {% endfor %}
  </div>
</section>
