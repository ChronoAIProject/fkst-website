{% extends "layouts/base.njk" %}

{% block content %}
{% include "components/ArticleScrollProgress.njk" %}
{# Source audit in shortcutActions.test.js keeps this inert scaffold at the current article shell boundary. #}
{% include "components/DocsSidebarShortcutScaffold.njk" %}
<section class="page-header article-header" aria-labelledby="page-title">
  {% if articleEyebrow %}
    <p class="eyebrow">{{ articleEyebrow }}</p>
  {% endif %}
  <h1 id="page-title">{{ articleTitle or title }}</h1>
  {% set estimate = content | readingTime %}
  <p class="article-meta" data-reading-time aria-label="Estimated reading time">
    <span>{{ estimate.label }}</span>
  </p>
  {% if articleIntro %}
    <p class="page-intro">{{ articleIntro }}</p>
  {% endif %}
</section>

<div class="page-content" data-article-scroll-content>
{{ content | safe }}
</div>
{% endblock %}

{% block scripts %}
    {{ super() }}
    <script src="{{ "/assets/js/article-scroll-progress.js" | url }}" defer data-article-scroll-progress-script></script>
{% endblock %}
