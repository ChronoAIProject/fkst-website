<section class="page-header article-header" aria-labelledby="page-title">
  {% if postEyebrow %}
    <p class="eyebrow">{{ postEyebrow }}</p>
  {% endif %}
  <h1 id="page-title">{{ postTitle }}</h1>
  {% set estimate = content | readingTime %}
  <p class="article-meta" data-reading-time aria-label="Estimated reading time">
    <span>{{ estimate.label }}</span>
  </p>
  {% if postIntro %}
    <p class="page-intro">{{ postIntro }}</p>
  {% endif %}
</section>
