{% extends "layouts/base.njk" %}

{% block content %}
{% set articleContent %}
{{ content | safe }}
{% endset %}
{% if hasTableOfContents %}
  {% set tableOfContents = articleContent | tocEntries %}
{% else %}
  {% set tableOfContents = [] %}
{% endif %}

<section class="page-header article-header" aria-labelledby="page-title">
  {% if articleEyebrow %}
    <p class="eyebrow">{{ articleEyebrow }}</p>
  {% endif %}
  <h1 id="page-title">{{ articleTitle or title }}</h1>
  {% set estimate = content | readingTime %}
  <p class="article-meta" data-reading-time aria-label="Estimated reading time">
    <span>{{ estimate.label }}</span>
  </p>
  {% if articleIntro %}
    <p class="page-intro">{{ articleIntro }}</p>
  {% endif %}
</section>

{% if tableOfContents | length %}
  <div class="article-shell">
    {% include "components/TableOfContents.njk" %}
    <div class="page-content article-main">
      {{ articleContent | safe }}
    </div>
  </div>
  <script src="{{ "/assets/js/table-of-contents.js" | url }}" defer data-toc-script></script>
{% else %}
  <div class="page-content">
    {{ articleContent | safe }}
  </div>
{% endif %}
{% endblock %}
